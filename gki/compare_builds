import kernel_processing

'''
# Purpose

Compare two GKI distributions, a freshly-built one and a given one.

# Operation

Per distribution:

* find binary artefacts
   * boot image containing a kernel image, possibly compressed
   * module.ko, signed
   * kernel image, possibly compressed
   * vmlinux
   * system dlkm filesystem image
* process each artefact to generate derived artefacts
   * decompress compressed kernel image
   * unpack file system image
   * extract kernel from boot image, checking ramdisk is empty
   * convert vmlinux to image
   * strip trailing module signature
   * blank kernel module signing certificate
   * blank kernel image build ID
   * optionally strip debug information
   * optionally strip BTF information
* each artefact -> derived artefact process creates an edge in a graph
   * except for system dlkm image unpacking

Every artefact file is hashed (SHA256, truncated to 12 characters).

We now have a collection (per distribution) of artefacts, each has:

* a logical name
* a file hash
* one or more file names

And we have edges from "original" to "equivalent" artefacts.

Between the two sides, files are matched by logical name and hash.

Anything on the given side with no path to the built side is considered
to be "unverified".

# External Dependencies

7z - unpack ext4 filesystem images
fsck.erofs - unpack erofs images
git - get common commit hash, for informational purposes
llvm-objcopy - convert vmlinux to Image; trim module signature; remove ELF sections
'''

def blank_kernel_build_ID(kernel: bytearray) -> None:
    '''Blank the kernel build ID.

    The kernel has a single section containing 3 notes, the last of
    which has the GNU build ID. The ID consists of 20 random bytes.
    '''
    regex = (
        rb'\x06\x00\x00\x00\x01\x00\x00\x00\x00\x01\x00\x00Linux\x00\x00\x00\x00\x00\x00\x00'
        rb'\x06\x00\x00\x00\x04\x00\x00\x00\x01\x01\x00\x00Linux\x00\x00\x00\x00\x00\x00\x00'
        rb'\x04\x00\x00\x00\x14\x00\x00\x00\x03\x00\x00\x00GNU\x00.{20}'
    )
    found = re.search(regex, kernel, flags=re.DOTALL)
    if not found:
        raise ValueError('no kernel notes found')
    kernel[found.end() - 20:found.end()] = bytearray(20)


def blank_kernel_module_certificate(kernel: bytearray) -> None:
    '''The start of the ASN.1 module signing certificate looks like this.

    SEQUENCE 30 82 hi lo
      SEQUENCE 30 82 hi lo
        CONTEXT[0] a0 03
          INTEGER 02 01 02 (2, meaning version 3)
        INTEGER 02 lo bytes (serial number, 1 to 20 bytes)
        SEQUENCE 30 0d (signature)
          OID 06 09 2a 86 48 86 f7 0d 01 01 05 (algorithm = sha1WithRSAEncryption)
          NULL 05 00 (parameters)
        SEQUENCE 30 2e (rdnSequence)
          SET 31 2c
            SEQUENCE 30 2a
              OID 06 03 55 04 03 (type = commonName)
              UTF8STRING 0c 23 "Build time autogenerated kernel key"
    '''
    regex = (
        rb'\x30\x82(..)\x30\x82..\xa0\x03\x02\x01\x02\x02(.)(.{1,20})'
        rb'\x30\x0d\x06\x09\x2a\x86\x48\x86\xf7\x0d\x01\x01\x05\x05\x00'
        rb'\x30\x2e\x31\x2c\x30\x2a\x06\x03\x55\x04\x03\x0c\x23Build time autogenerated kernel key'
    );
    found = re.search(regex, kernel, flags=re.DOTALL)
    if not found:
        raise ValueError('no kernel module signing certificate found')
    length_bytes, serial_length_bytes, serial = found.group(1, 2, 3)
    serial_length = int.from_bytes(serial_length_bytes, 'big')
    if serial_length != len(serial):
        raise ValueError('serial number length mismatch')
    length = 4 + int.from_bytes(length_bytes, 'big')
    kernel[found.start():found.start() + length] = bytearray(length)


def hash_file(path: pathlib.Path) -> str:
    with path.open('rb') as f:
        return hashlib.file_digest(f, 'sha256').hexdigest()[0:12]


def get_kernel_information(which: str, kernel: bytes) -> tuple[str, str, str, str, int]:
    banner_info = kernel_processing.get_linux_banner(kernel)

    print('''{which} version information:
    banner: {banner}
    release: {uts_release}
    scmversion: {scmversion}
    commit: {commit}
    build: {build}
    version: {uts_version}
    date: {date}
    epoch: {epoch}
'''.format(which=which, **dataclasses.asdict(banner_info)))

    return (
        banner_info.uts_release,
        banner_info.uts_version,
        banner_info.commit,
        banner_info.build,
        banner_info.epoch,
    )


class Info(typing.NamedTuple):
    distribution: pathlib.Path
    release: str
    version: str
    commit: str
    build: str
    epoch: int
    working_directory: pathlib.Path
    nodes: dict[str, set[str]]
    edges: dict[str, set[tuple[str, str]]]


def add_artefact(info: Info, name: str, path: pathlib.Path) -> str:
    sha = hash_file(path)
    key = f'{name}:{sha}'
    nodes = info.nodes
    if key in nodes:
        nodes[key].add(path)
    else:
        nodes[key] = set([path])
        info.edges[key] = set()
    return key


def add_edge(info: Info, key1: str, key2: str, label: str) -> None:
    if key1 == key2:
        logging.warning(f'ignoring attempt to add loop: {key1} --{label}-> {key2}')
        return
    info.edges[key1].add((key2, label))


def process_kernel(gki: pathlib.Path, info: Info, kernel: str, kernel_path: pathlib.Path) -> str:
    key1 = add_artefact(info, kernel, kernel_path)
    _DECOMPRESSORS = {
        'Image': None,
        'Image.gz': gki / 'prebuilts' / 'build-tools' / 'path' / 'linux-x86' / 'gzip',
        'Image.lz4': gki / 'prebuilts' / 'kernel-build-tools' / 'linux-x86' / 'bin' / 'lz4',
    }
    decompressor = _DECOMPRESSORS[kernel]
    if decompressor is not None:
        uncompressed_path = info.working_directory / (kernel + '.uncompressed')
        with uncompressed_path.open('wb') as f:
            subprocess.check_call([decompressor, '-d', '-c', '--', kernel_path], stdout=f)
            key2 = add_artefact(info, 'Image', uncompressed_path)
            add_edge(info, key1, key2, 'decompress')
    return key1


def create_kernel(vmlinux: pathlib.Path, kernel: pathlib.Path) -> None:
    subprocess.check_call(['llvm-objcopy', '-S', '-O', 'binary', vmlinux, kernel])


def canonicalise_kernel(info: Info, original: pathlib.Path, canonical: pathlib.Path) -> None:
    array = bytearray(original.read_bytes())
    blank_kernel_build_ID(array)
    blank_kernel_module_certificate(array)
    canonical.write_bytes(array)


def process_vmlinux(info: Info, copy_args) -> None:
    vmlinux_path = info.distribution / 'vmlinux'
    key1 = add_artefact(info, 'vmlinux', vmlinux_path)

    recreated_kernel_path = info.working_directory / 'vmlinux.Image'
    create_kernel(vmlinux_path, recreated_kernel_path)
    key2 = add_artefact(info, 'Image', recreated_kernel_path)
    add_edge(info, key1, key2, 'make image')

    canonical_vmlinux_path = info.working_directory / 'vmlinux.canonical'
    canonicalise_kernel(info, vmlinux_path, canonical_vmlinux_path)
    key3 = add_artefact(info, 'vmlinux', canonical_vmlinux_path)
    add_edge(info, key1, key3, 'canonicalise')

    canonical_kernel_path = info.working_directory / 'vmlinux.Image.canonical'
    canonicalise_kernel(info, recreated_kernel_path, canonical_kernel_path)
    key4 = add_artefact(info, 'Image', canonical_kernel_path)
    add_edge(info, key2, key4, 'canonicalise')

    copied_canonical_vmlinux_path = info.working_directory / 'vmlinux.canonical.objcopy'
    subprocess.run(['llvm-objcopy', *copy_args, canonical_vmlinux_path, copied_canonical_vmlinux_path], check=True)
    key5 = add_artefact(info, 'vmlinux', copied_canonical_vmlinux_path)
    add_edge(info, key3, key5, 'objcopy')


def process_boot_image(gki: pathlib.Path, info: Info, kernel: str, boot_image: str, boot_image_path: pathlib.Path) -> None:
    unpacked = info.working_directory / (boot_image + '.unpacked')
    subprocess.check_call([gki / 'tools' / 'mkbootimg' / 'unpack_bootimg.py',
                           '--boot_img', boot_image_path, '--format', 'info', '--out', unpacked],
                          stdout=subprocess.DEVNULL)
    ramdisk_file = unpacked / 'ramdisk'
    kernel_file =  unpacked / 'kernel'
    if os.stat(ramdisk_file).st_size > 0:
        logging.error(f'non-empty ramdisk {ramdisk_file} from {boot_image}')
    key1 = add_artefact(info, boot_image, boot_image_path)
    key2 = process_kernel(gki, info, kernel, kernel_file)
    add_edge(info, key1, key2, 'extract')


def process_module(info: Info, copy_args: list[str], root_path: pathlib.Path, module_name: str) -> None:
    module_path = root_path / module_name
    key1 = add_artefact(info, module_name, module_path)
    copied_path = root_path / (module_name + '.objcopy')
    subprocess.check_call(['llvm-objcopy', *copy_args, module_path, copied_path])
    key2 = add_artefact(info, module_name, copied_path)
    add_edge(info, key1, key2, 'objcopy')


def process_system_dlkm(info: Info, copy_args: list[str], unpacked: pathlib.Path) -> None:
    for root, dirs, files in os.walk(unpacked):
        for name in files:
            if name.endswith('.ko'):
                root_path = pathlib.Path(root)
                process_module(info, copy_args, root_path, name)


def process_distribution(gki: pathlib.Path, info: Info, copy_args: list[str]) -> None:
    process_vmlinux(info, copy_args)

    _BOOT_IMAGES = {
        'Image': 'boot.img',
        'Image.gz': 'boot-gz.img',
        'Image.lz4': 'boot-lz4.img',
    }
    for kernel, boot_image in _BOOT_IMAGES.items():
        kernel_path = info.distribution / kernel
        if kernel_path.exists():
            process_kernel(gki, info, kernel, kernel_path)
        boot_image_path = info.distribution / boot_image
        if boot_image_path.exists():
            process_boot_image(gki, info, kernel, boot_image, boot_image_path)

    _FILESYSTEMS = {
        'erofs' : lambda archive, unpacked: ['fsck.erofs', f'--extract={unpacked}', '--', archive],
        'ext4' : lambda archive, unpacked: ['7z', f'-o{unpacked}', 'x', archive],
    }
    for name in os.listdir(info.distribution):
        if name.endswith('.ko'):
            pathlib.Path(info.working_directory / name).write_bytes(
                pathlib.Path(info.distribution / name).read_bytes())
            process_module(info, copy_args, info.working_directory, name)
        elif m := re.fullmatch(r'system_dlkm.*\.(erofs|ext4)\.img', name):
            fs = m.group(1)
            archive = info.distribution / name
            unpacked = info.working_directory / (name + '.unpacked')
            unpack = _FILESYSTEMS[fs](archive, unpacked)
            subprocess.check_call(unpack, stdout=subprocess.DEVNULL)
            process_system_dlkm(info, copy_args, unpacked)


def initialise_side(side: str, distribution: pathlib.Path, temporary_path: pathlib.Path) -> Info:
    vmlinux = distribution / 'vmlinux'
    vmlinux_bytes = vmlinux.read_bytes()
    release, version, commit, build, epoch = get_kernel_information(side, vmlinux_bytes)
    working_directory = temporary_path / side
    os.mkdir(working_directory)
    return Info(distribution, release, version, commit, build, epoch, working_directory, {}, {})


def compare_metadata(gki: pathlib.Path, built: Info, given: Info):
    keys = ['release', 'version', 'commit', 'build', 'epoch']
    def values(info: Info):
        return [info.release, info.version, info.commit, info.build, info.epoch]
    for key, (built_value, given_value) in zip(keys, zip(values(built), values(given))):
        if built_value != given_value:
            logging.warning(f'mismatched {key}: {built_value} != {given_value}')

    built_abi = built.distribution / 'abi.stg'
    given_abi = given.distribution / 'abi.stg'
    completed = subprocess.run([gki / 'prebuilts' / 'kernel-build-tools' / 'linux-x86' / 'bin' / 'stgdiff', '-s', built_abi, given_abi])
    if completed.returncode:
        logging.error(f'stgdiff -s {built_abi} {given_abi} failed')


def build_gki(gki: pathlib.Path, commit: str, build: str, epoch: int) -> pathlib.Path:
    if commit is not None:
        # 12 character SHA as requested by Kleaf
        gki_commit = subprocess.check_output(
            ['git', 'rev-parse', '--short=12', 'HEAD'],
            cwd=gki / 'common', text=True).rstrip('\n')
        if commit != gki_commit:
            logging.warning(f'mismatched commits: {commit} != {gki_commit}')
    env = os.environ.copy()
    env['BUILD_NUMBER'] = build
    env['SOURCE_DATE_EPOCH'] = str(epoch)
    subprocess.check_call(
        ['tools/bazel', 'run', '--config=release', '//common:kernel_aarch64_abi_dist'],
        cwd=gki, env=env)
    return gki / 'out_abi' / 'kernel_aarch64' / 'dist'


def partition(predicate, items):
    result = ([], [])
    for element in items:
        result[predicate(element)].append(element)
    return result

def report_artefacts(built_nodes, given_nodes, given_edges, happy: str, sad: str) -> int:
    def is_good(memo: dict[str, bool], node: str) -> bool:
        if node not in memo:
            memo[node] = any(is_good(memo, n) for n, label in given_edges[node])
        return memo[node]

    memo = {node: True for node in built_nodes}
    check = lambda n: is_good(memo, n)
    bad_nodes, good_nodes = partition(check, sorted(given_nodes.keys()))

    if good_nodes:
        print(f'{len(good_nodes)} {happy} artefacts')
        print()
    if bad_nodes:
        print(f'{len(bad_nodes)} {sad} artefacts:')
        for node in bad_nodes:
            files = ' '.join(sorted(map(str, given_nodes[node])))
            print(f'  {node} ({files})')
            for other, label in given_edges[node]:
                print(f'    --{label}-> {other}')
        print()

    return len(bad_nodes)


def main() -> int:
    logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')

    parser = argparse.ArgumentParser()
    parser.add_argument('--strip-btf', action='store_true')
    parser.add_argument('--strip-debug', action='store_true')
    parser.add_argument('--gki', required=True, type=pathlib.Path, help='GKI tree')
    parser.add_argument('--built', required=False, type=pathlib.Path, help='built GKI distribution directory')
    parser.add_argument('--given', required=True, type=pathlib.Path, help='given GKI distribution directory')
    args = parser.parse_args()

    gki_path = args.gki
    built_path = args.built
    given_path = args.given
    copy_args = []
    if args.strip_debug:
        copy_args.append('--strip-debug')
    if args.strip_btf:
        copy_args.extend(['-R', '.BTF', '-R', '.BTF_ids'])

    with tempfile.TemporaryDirectory() as t:
        temporary_path = pathlib.Path(t)

        given = initialise_side('given', given_path, temporary_path)
        logging.debug(f'given = {given}')

        if built_path is None:
            built_path = build_gki(gki_path, given.commit, given.build, given.epoch)

        built = initialise_side('built', built_path, temporary_path)
        logging.debug(f'built = {built}')

        compare_metadata(gki_path, given, built)

        with concurrent.futures.ThreadPoolExecutor(max_workers=2) as executor:
            futures = [
                executor.submit(process_distribution, gki_path, info, copy_args)
                for info in [given, built]
            ]
            for f in futures:
                f.result()

        problems = (report_artefacts(given.nodes, built.nodes, built.edges, 'present', 'missing') +
                    report_artefacts(built.nodes, given.nodes, given.edges, 'verified', 'unverified'))
        if problems > 0:
            input(f'temporary working directory is {t}; press enter to exit')
            return 1

        build_ID = hashlib.sha256(given.release.encode()).hexdigest()
        print(f'verified build ID: {build_ID}')
        return 0


if __name__ == '__main__':
    sys.exit(main())
